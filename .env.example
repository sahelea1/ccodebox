# Copy this file to `.env` and fill in your own API key.
#   cp .env.example .env
#
# .env is gitignored. Never commit your real key.

# Ollama Cloud API key.
#   Get one from https://ollama.com/ -> Settings -> Keys -> Add API Key
# The continuous-code agents default to ollama-cloud/deepseek-v4-pro and
# ollama-cloud/deepseek-v4-flash, both served by Ollama Cloud.
OLLAMA_API_KEY=

# Optional: change the host port the web UI is published on.
# PORT=7878
