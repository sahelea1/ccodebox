# Copy this file to `.env` and fill in your own API keys.
#   cp .env.example .env
#
# .env is gitignored. Never commit your real keys.

# Ollama Cloud API key.
#   Get one from https://ollama.com/ -> Settings -> Keys -> Add API Key
# The continuous-code agents default to ollama-cloud/deepseek-v4-pro and
# ollama-cloud/deepseek-v4-flash, both served by Ollama Cloud. Used by the
# OpenCode web UI.
OLLAMA_API_KEY=

# Anthropic API key for the official Claude Code CLI inside the container.
#   docker exec -it ccodebox claude
# Optional — if you leave this blank you can still authenticate interactively
# the first time you run `claude` (the token is persisted under
# /data/claude/claude.json so it survives `docker compose down`).
ANTHROPIC_API_KEY=

# Optional: change the host port the web UI is published on.
# PORT=7878
